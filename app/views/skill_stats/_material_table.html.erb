<section class="space-y-2" data-testid="<%= testid %>">
  <h2 class="text-lg font-semibold"><%= title %></h2>
  <p class="text-xs text-slate-500"><%= note %></p>
  <div class="overflow-x-auto rounded-lg border border-slate-800">
    <table class="w-full text-sm">
      <thead class="bg-slate-900/80 text-left text-slate-400">
        <tr>
          <th class="px-4 py-2 font-medium">Resource</th>
          <th class="px-4 py-2 text-right font-medium">
            <span class="inline-flex items-center justify-end gap-1">Total <%= verb %><%= hint_for(total_hint, align: :right) %></span>
          </th>
          <th class="px-4 py-2 text-right font-medium">
            <span class="inline-flex items-center justify-end gap-1"><%= rate_label %><%= hint_for(rate_hint, align: :right) %></span>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800">
        <% grouped_by_metal(quantities).each_with_index do |(_, rows), group_index| %>
          <% rows.each do |name, total| %>
            <tr class="<%= "bg-slate-900/40" if group_index.odd? %>">
              <td class="px-4 py-2 capitalize"><%= name %></td>
              <td class="px-4 py-2 text-right tabular-nums"><%= whole(total) %></td>
              <td class="px-4 py-2 text-right tabular-nums"><%= count(rate[name]) %></td>
            </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

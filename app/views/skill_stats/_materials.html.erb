<% if summary.gathered.any? %>
  <%= render "material_table", testid: "gathered-materials", title: "Gathered per swing",
        note: "One row per resource, picked up on any swing at a yield-covered step — not just ones that raised skill.",
        verb: "gathered", total_hint: :material_total_gathered, rate_hint: :material_per_swing_gathered, rate_label: "Per swing",
        quantities: summary.gathered, rate: summary.average_yield %>
<% end %>

<% if summary.consumption.any? %>
  <%= render "material_table", testid: "consumed-materials", title: "Consumed",
        note: "Spent converting one resource into another, such as smelting ore into ingots, expected per skill point of the covered range.",
        verb: "consumed", total_hint: :material_total_consumed, rate_hint: :material_per_point_consumed, rate_label: "Per skill point",
        quantities: summary.consumption, rate: summary.average_consumption %>
<% end %>

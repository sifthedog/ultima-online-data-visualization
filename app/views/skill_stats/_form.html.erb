<%= form_with url: root_path, method: :get, class: "rounded-lg border border-slate-800 bg-slate-900/60 p-5" do |f| %>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5 lg:items-end">
    <div class="lg:col-span-2 relative" data-controller="searchable-select">
      <%= f.label :skill, class: "block text-sm font-medium text-slate-300" %>
      <%= f.select :skill, form.skill_options, { selected: form.skill, prompt: "Choose a skill" },
            required: true, data: { searchable_select_target: "select" },
            class: "mt-1 w-full rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100" %>
      <input type="text" role="combobox" aria-expanded="false" aria-autocomplete="list" autocomplete="off"
             placeholder="Search skills&hellip;" hidden
             data-searchable-select-target="input"
             data-action="input->searchable-select#filter focus->searchable-select#open keydown->searchable-select#keydown blur->searchable-select#close"
             class="mt-1 w-full rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100" />
      <ul role="listbox" hidden data-searchable-select-target="list"
          class="absolute z-10 mt-1 max-h-60 w-full overflow-auto rounded-md border border-slate-700 bg-slate-950 py-1 text-slate-100 shadow-lg">
        <% form.skill_options.each do |label, key| %>
          <li role="option" data-value="<%= key %>" data-searchable-select-target="option"
              data-action="mousedown->searchable-select#pick:prevent"
              class="cursor-pointer px-3 py-2 hover:bg-slate-800">
            <%= label %>
          </li>
        <% end %>
      </ul>
    </div>
    <div>
      <%= f.label :from, class: "block text-sm font-medium text-slate-300" %>
      <%= f.number_field :from, value: form.from, step: 0.1, min: 0, max: 120,
            class: "mt-1 w-full rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100" %>
    </div>
    <div>
      <%= f.label :to, class: "block text-sm font-medium text-slate-300" %>
      <%= f.number_field :to, value: form.to, step: 0.1, min: 0, max: 120,
            class: "mt-1 w-full rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100" %>
    </div>
    <div>
      <%= f.label :gain_path, "Path", class: "block text-sm font-medium text-slate-300" %>
      <%= f.select :gain_path, form.gain_path_options, { selected: form.chosen_gain_path, include_blank: "All" },
            class: "mt-1 w-full rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100" %>
    </div>
  </div>
  <% if form.subject_options.any? %>
    <div class="mt-4">
      <%= f.label :subjects, class: "block text-sm font-medium text-slate-300" do %>
        <span class="inline-flex items-center gap-1">Subjects<%= hint_for(:subject_column) %></span>
      <% end %>
      <%= f.select :subjects, form.subject_options.map { |subject| [ subject.titleize, subject ] },
            { selected: form.chosen_subjects, include_hidden: false }, multiple: true, size: 5,
            class: "mt-1 w-full rounded-md border border-slate-700 bg-slate-950 px-3 py-2 text-slate-100" %>
      <p class="mt-1 text-xs text-slate-500">Leave empty for all subjects. Hold Cmd or Ctrl to pick several.</p>
    </div>
  <% end %>
  <div class="mt-4 flex items-center justify-between gap-4">
    <p class="text-xs text-slate-500">From is inclusive, to is exclusive: 60 to 70 covers the gains from 60.0 up to 70.0.</p>
    <div class="flex items-center gap-4">
      <%= link_to "Clear filters", root_path, class: "text-sm text-slate-400 underline hover:text-slate-200" if form.filled? %>
      <%= f.submit "Show", class: "rounded-md bg-sky-600 px-4 py-2 font-medium text-white hover:bg-sky-500" %>
    </div>
  </div>
<% end %>

<section class="space-y-2" data-testid="subjects">
  <h2 class="text-lg font-semibold">By subject</h2>
  <p class="text-xs text-slate-500">Each subject covers its own sub-range, so expected attempts are only comparable where coverage matches.</p>
  <div class="overflow-x-auto rounded-lg border border-slate-800">
    <table class="w-full text-sm">
      <thead class="bg-slate-900/80 text-left text-slate-400">
        <tr>
          <th class="px-4 py-2 font-medium">
            <span class="inline-flex items-center gap-1">Subject<%= hint_for(:subject_column) %></span>
          </th>
          <th class="px-4 py-2 text-right font-medium">
            <span class="inline-flex items-center justify-end gap-1">Attempts<%= hint_for(:attempts_column, align: :right) %></span>
          </th>
          <th class="px-4 py-2 text-right font-medium">
            <span class="inline-flex items-center justify-end gap-1">Success rate<%= hint_for(:success_rate, align: :right) %></span>
          </th>
          <th class="px-4 py-2 text-right font-medium">
            <span class="inline-flex items-center justify-end gap-1">Expected attempts<%= hint_for(:expected_attempts, align: :right) %></span>
          </th>
          <th class="px-4 py-2 text-right font-medium">
            <span class="inline-flex items-center justify-end gap-1">Coverage<%= hint_for(:coverage, align: :right) %></span>
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-800">
        <% by_subject.each do |subject, summary| %>
          <tr>
            <td class="px-4 py-2"><%= link_to subject, root_path(skill: params[:skill], from: params[:from], to: params[:to], subject: subject), class: "text-sky-400 hover:underline" %></td>
            <td class="px-4 py-2 text-right tabular-nums"><%= whole(summary.attempts) %></td>
            <td class="px-4 py-2 text-right tabular-nums"><%= percent(summary.success_rate) %></td>
            <td class="px-4 py-2 text-right tabular-nums"><%= count(summary.expected_attempts) %></td>
            <td class="px-4 py-2 text-right tabular-nums"><%= whole(summary.covered_steps) %> steps (<%= percent(summary.coverage_ratio) %>)</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

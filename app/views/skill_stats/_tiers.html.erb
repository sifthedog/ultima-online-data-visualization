<section class="space-y-2" data-testid="tiers">
  <h2 class="flex items-center gap-1 text-lg font-semibold">By skill point<%= hint_for(:tier_items) %></h2>
  <p class="text-xs text-slate-500">Each item's unbroken run of skill points; expand a row to see the 1.0-point figures behind it.</p>
  <div class="divide-y divide-slate-800 rounded-lg border border-slate-800 text-sm">
    <div class="grid grid-cols-[8rem_1fr_7rem_1fr] gap-2 bg-slate-900/80 px-4 py-2 text-left font-medium text-slate-400">
      <span>Skill point</span>
      <span>Item</span>
      <span class="text-right">Attempts/point</span>
      <span>Materials/point</span>
    </div>
    <% tiers.each do |tier| %>
      <details class="group" data-testid="tier">
        <summary class="grid grid-cols-[8rem_1fr_7rem_1fr] items-baseline gap-2 px-4 py-2 cursor-pointer list-none [&::-webkit-details-marker]:hidden hover:bg-slate-900/40">
          <span class="tabular-nums">
            <span aria-hidden="true" class="mr-1 inline-block text-slate-500 transition-transform group-open:rotate-90">›</span><%= skill_span(tier.from_tenths, tier.to_tenths) %>
          </span>
          <span><%= tier.subject %></span>
          <span class="text-right tabular-nums"><%= attempts_per_point_text(tier.summary.attempts_per_point) %></span>
          <span class="text-slate-300"><%= materials_text(tier.summary.average_consumption) %></span>
        </summary>
        <div class="divide-y divide-slate-800/60 bg-slate-950/40">
          <% tier.points.each do |point| %>
            <div class="grid grid-cols-[8rem_1fr_7rem_1fr] items-baseline gap-2 px-4 py-2 text-slate-400">
              <span class="pl-4 tabular-nums"><%= skill_span(point.point * 10, (point.point + 1) * 10) %></span>
              <span></span>
              <span class="text-right tabular-nums"><%= attempts_per_point_text(point.scaled) %></span>
              <span><%= materials_text(point.consumption) %></span>
            </div>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>
</section>
